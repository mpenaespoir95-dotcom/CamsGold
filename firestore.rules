rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function profilePath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function hasValidProfile() {
      return isSignedIn()
        && request.auth.token.email_verified == true
        && exists(profilePath(request.auth.uid))
        && get(profilePath(request.auth.uid)).data.active == true
        && get(profilePath(request.auth.uid)).data.role in [
          'ADMIN', 'CASHIER', 'BUYER', 'SALES', 'AUDITOR'
        ];
    }

    function hasRole(roles) {
      return hasValidProfile()
        && get(profilePath(request.auth.uid)).data.role in roles;
    }

    function isAdmin() {
      return hasRole(['ADMIN']);
    }

    match /users/{uid} {
      allow get: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create: if isAdmin() || (
        isSignedIn()
        && request.auth.uid == uid
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['espoirmpena5@gmail.com', 'mpenaespoir95@gmail.com']
        && request.resource.data.role == 'ADMIN'
        && request.resource.data.active == true
      );
      allow update, delete: if isAdmin();
    }

    match /pending_users/{uid} {
      allow create: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly([
          'name', 'email', 'phone', 'requestedRole', 'createdAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.requestedRole in [
          'ADMIN', 'CASHIER', 'BUYER', 'SALES', 'AUDITOR'
        ]
        && request.resource.data.createdAt == request.time
        && (
          !('phone' in request.resource.data)
          || request.resource.data.phone is string
        );
      allow get: if (isSignedIn() && request.auth.uid == uid) || isAdmin();
      allow list, update, delete: if isAdmin();
    }

    match /system/{docId} {
      allow read: if hasValidProfile();
    }

    match /purchases/{purchaseId} {
      allow read: if hasValidProfile();
      allow create, update: if hasRole(['ADMIN', 'CASHIER', 'BUYER']);
      allow delete: if isAdmin();
    }

    match /sales/{saleId} {
      allow read: if hasValidProfile();
      allow create, update: if hasRole(['ADMIN', 'SALES']);
      allow delete: if isAdmin();
    }

    match /stock_movements/{movementId} {
      allow read: if hasValidProfile();
      allow create, update: if hasRole(['ADMIN', 'CASHIER', 'BUYER', 'SALES']);
      allow delete: if isAdmin();
    }

    match /contacts/{contactId} {
      allow read: if hasValidProfile();
      allow create, update: if hasRole(['ADMIN', 'CASHIER', 'BUYER', 'SALES']);
      allow delete: if isAdmin();
    }

    match /operations/{operationId} {
      allow read: if hasValidProfile();
      allow create, update: if hasRole(['ADMIN', 'CASHIER']);
      allow delete: if isAdmin();
    }

    match /accounts/{accountId} {
      allow read: if hasValidProfile();
      allow create, update: if hasRole(['ADMIN', 'CASHIER']);
      allow delete: if isAdmin();
    }

    match /settings/{settingsId} {
      allow read: if hasValidProfile();
      allow create, update, delete: if isAdmin();
    }

    match /tasks/{taskId} {
      allow read: if hasValidProfile();
      allow create, update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
